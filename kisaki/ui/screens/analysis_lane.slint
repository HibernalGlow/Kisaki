import { ScrollView } from "std-widgets.slint";
import { Palette, Theme } from "../globals/theme.slint";
import { AppState } from "../globals/app_state.slint";
import { SelectCriterion, SelectExtreme, SelectRule, ToolId } from "../globals/common.slint";
import { Callabler } from "../globals/callabler.slint";
import { Translations } from "../globals/translations.slint";
import { ButtonVariant, Capsule, MetricTile, ToggleRow } from "../components/atoms.slint";

export component AnalysisBody inherits Rectangle {
    VerticalLayout {
        spacing: 0px;

        // Hairline-separated metric readout: the 1px gaps between tiles are the
        // dividers.
        Rectangle {
            height: Theme.metric_height;
            background: Palette.hairline;

            HorizontalLayout {
                spacing: 1px;

                MetricTile {
                    label: Translations.metric_files;
                    value: AppState.metrics.has_results ? "\{AppState.metrics.files}" : "-";
                    horizontal-stretch: 1;
                }
                MetricTile {
                    label: Translations.metric_groups;
                    value: AppState.metrics.has_results ? "\{AppState.metrics.groups}" : "-";
                    horizontal-stretch: 1;
                }
                MetricTile {
                    label: Translations.metric_total;
                    value: AppState.metrics.has_results ? AppState.metrics.total_size : "-";
                    horizontal-stretch: 1;
                }
                MetricTile {
                    label: Translations.metric_reclaimable;
                    value: AppState.metrics.has_results ? AppState.metrics.reclaimable : "-";
                    accent: true;
                    horizontal-stretch: 1;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: stretch;
                spacing: Theme.gap_small;
                padding: Theme.pad;

                HorizontalLayout {
                    spacing: 1px;
                    height: Theme.metric_height;

                    MetricTile {
                        label: Translations.metric_selected;
                        value: "\{AppState.metrics.selected}";
                        horizontal-stretch: 1;
                    }
                    MetricTile {
                        label: Translations.metric_selected_size;
                        value: AppState.metrics.selected_size;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: Translations.hint_dry_run;
                    color: Palette.fg_faint;
                    font-size: Theme.fs_caption;
                    wrap: word-wrap;
                }

                ToggleRow {
                    text: Translations.label_dry_run;
                    checked: AppState.dry_run;
                    clicked => {
                        AppState.dry_run = !AppState.dry_run;
                    }
                }
                ToggleRow {
                    text: Translations.label_trash;
                    checked: AppState.move_to_trash;
                    enabled: !AppState.running && !AppState.dry_run;
                    clicked => {
                        AppState.move_to_trash = !AppState.move_to_trash;
                    }
                }

                // Bulk selection, so a group of duplicates does not have to be clicked one by one.
                Text {
                    text: Translations.select_heading;
                    color: Palette.fg_faint;
                    font-size: Theme.fs_caption;
                }
                HorizontalLayout {
                    spacing: Theme.gap_small;
                    alignment: start;

                    Capsule {
                        text: Translations.select_by_size;
                        variant: AppState.selection_criterion == SelectCriterion.Size ? ButtonVariant.Primary : ButtonVariant.Neutral;
                        enabled: AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            AppState.selection_criterion = SelectCriterion.Size;
                        }
                    }
                    Capsule {
                        text: Translations.select_by_date;
                        variant: AppState.selection_criterion == SelectCriterion.Date ? ButtonVariant.Primary : ButtonVariant.Neutral;
                        enabled: AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            AppState.selection_criterion = SelectCriterion.Date;
                        }
                    }
                    Capsule {
                        text: Translations.select_by_path;
                        variant: AppState.selection_criterion == SelectCriterion.PathLength ? ButtonVariant.Primary : ButtonVariant.Neutral;
                        enabled: AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            AppState.selection_criterion = SelectCriterion.PathLength;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap_small;
                    alignment: start;

                    Capsule {
                        text: Translations.select_max;
                        variant: AppState.selection_extreme == SelectExtreme.Largest ? ButtonVariant.Primary : ButtonVariant.Neutral;
                        enabled: AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            AppState.selection_extreme = SelectExtreme.Largest;
                        }
                    }
                    Capsule {
                        text: Translations.select_min;
                        variant: AppState.selection_extreme == SelectExtreme.Smallest ? ButtonVariant.Primary : ButtonVariant.Neutral;
                        enabled: AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            AppState.selection_extreme = SelectExtreme.Smallest;
                        }
                    }
                    Capsule {
                        text: Translations.select_pick_one;
                        enabled: AppState.has_results && AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            Callabler.select_rows(SelectRule.PickOne);
                        }
                    }
                    Capsule {
                        text: Translations.select_pick_all_but_one;
                        enabled: AppState.has_results && AppState.can_group_select;
                        cap_height: 32px;
                        clicked => {
                            Callabler.select_rows(SelectRule.PickAllButOne);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap_small;
                    alignment: start;

                    Capsule {
                        text: Translations.select_invert;
                        enabled: AppState.has_results && !AppState.running;
                        cap_height: 32px;
                        clicked => {
                            Callabler.select_rows(SelectRule.Invert);
                        }
                    }
                    Capsule {
                        text: Translations.select_invert_group;
                        enabled: AppState.has_results && AppState.can_group_select && !AppState.running;
                        cap_height: 32px;
                        clicked => {
                            Callabler.select_rows(SelectRule.InvertGroup);
                        }
                    }
                }

                Capsule {
                    text: Translations.action_delete;
                    variant: ButtonVariant.Danger;
                    enabled: AppState.can_delete;
                    cap_height: 32px;
                    clicked => {
                        Callabler.delete_selected();
                    }
                }
                // Only the files the EXIF scan listed can be stripped, so the verb stays disabled
                // for every other tool rather than disappearing mid-session.
                Capsule {
                    text: Translations.action_strip_exif;
                    variant: ButtonVariant.Neutral;
                    enabled: AppState.active_tool == ToolId.ExifRemover && AppState.can_delete;
                    cap_height: 32px;
                    clicked => {
                        Callabler.strip_exif();
                    }
                }
                Capsule {
                    text: Translations.action_export;
                    variant: ButtonVariant.Neutral;
                    enabled: AppState.has_results && !AppState.running;
                    cap_height: 32px;
                    clicked => {
                        Callabler.export_results();
                    }
                }
            }
        }
    }
}
