# The blanket rules above hide part of the Flutter frontend: `*.txt` swallows the six CMake files
# that build it for Linux and Windows, and `test/` swallows every Dart test file added after the
# scaffold was committed. Negating them scoped to kisaki_app, so no upstream path changes status.
!kisaki_app/**/CMakeLists.txt
!kisaki_app/test/
!kisaki_app/test/**

# Same reason for the extracted packages: without these two lines a package's tests are invisible to
# git, so the package ships with its only proof left behind.
!packages/**/test/
!packages/**/test/**

# ...but a package's own build output stays out, the same way kisaki_app's does (its own
# .gitignore holds `/build/`; a package under this repo has none).
packages/**/.dart_tool/
packages/**/build/
packages/**/pubspec.lock
